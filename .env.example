# Server Configuration
PORT=3000
NODE_ENV=development
API_PREFIX=api/v1

# Security & CORS
FRONTEND_URL=http://localhost:3000

# Observability (Optional in local development)
OBSERVE_APP_KEY=
OBSERVE_APP_SECRET=

# Database (Required for Milestone 2: Database)
